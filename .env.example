# Server
PORT=3001
# Origin(s) allowed to open sockets (comma separated). Not needed when the server serves the built client.
CLIENT_ORIGIN=http://localhost:5173
# Delay between each bot action (roll / hold / score), in ms
BOT_DELAY_MS=1100
# Waiting rooms expire after this long without an opponent (minutes)
WAITING_ROOM_TTL_MIN=30
# Rooms with no activity expire after this long (minutes)
IDLE_ROOM_TTL_MIN=120
# If every human is disconnected, the room is kept this long for reconnects (minutes)
RECONNECT_GRACE_MIN=15
